# URL web app dari deploy Google Apps Script (lihat backend/SETUP.md langkah 5)
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/xxxxxxxx/exec

# Cloudinary, dipakai buat upload foto produk dari panel admin.
# Cloud name kelihatan di dashboard Cloudinary atau di URL foto (res.cloudinary.com/<cloud_name>/...).
# Upload preset dibuat di Settings > Upload > Upload presets > Add upload preset > Signing Mode: Unsigned.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxxxxxxx
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=xxxxxxxx

# ---------------------------------------------------------------------------
# Portal UMKM. Dua nilai di bawah SENGAJA TANPA awalan NEXT_PUBLIC_.
# Awalan itu membuat nilainya ikut terbundel ke browser dan terbaca siapa pun
# yang membuka halaman. Jangan pernah menambahkannya ke dua baris ini.
# ---------------------------------------------------------------------------

# Rahasia server-ke-server antara Next.js dan Apps Script.
# Dibuat dengan menjalankan aturPortalSecret() di editor Apps Script, lalu
# nilainya disalin dari Logger ke sini.
APPS_SCRIPT_SECRET=xxxxxxxx

# Kunci penanda tangan cookie sesi. Minimal 32 karakter, acak.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Menggantinya akan mengeluarkan semua orang yang sedang masuk. Itu memang cara
# tercepat mengusir sesi yang bocor.
SESSION_SECRET=xxxxxxxx
